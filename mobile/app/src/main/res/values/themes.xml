<resources>
    <!-- Base application theme. -->
    <style name="Theme.MotoMeet" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/bg_main</item>
        <item name="colorAccent">@color/accent</item>

        <!-- Customize your theme here. -->
        <item name="android:windowBackground">@color/bg_main</item>
        <item name="android:textColorPrimary">@color/text_main</item>
        <item name="android:textColorSecondary">@color/text_soft</item>
        <item name="editTextStyle">@style/MotoMeetEditText</item>
    </style>

    <style name="MotoMeetEditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:padding">12dp</item>
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textColorHint">@color/text_soft</item>
    </style>
</resources>
